{
    "name": "crabphp/framework",
    "description": "A minimal PHP 8.4 web framework on the Crab networking engine",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "revolt/event-loop": "^1.0",
        "psr/http-message": "^2.0",
        "psr/http-factory": "^1.1",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/container": "^2.0",
        "psr/log": "^3.0",
        "psr/clock": "^1.0"
    },
    "replace": {
        "crabphp/engine": "self.version"
    },
    "suggest": {
        "ext-pcntl": "Supervised parallel workers and Unix signals",
        "ext-posix": "Supervised worker termination and lifecycle control"
    },
    "bin": [
        "bin/crab"
    ],
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "test:linux": "tests/linux/run.sh",
        "soak": "python3 benchmarks/soak.py"
    },
    "autoload": {
        "psr-4": {
            "Crab\\": "src/"
        },
        "files": [
            "src/Config/helpers.php",
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Crab\\Engine\\Tests\\": "tests/Engine/",
            "Crab\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "bangnokia",
            "email": "bangnokia@gmail.com"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    }
}
