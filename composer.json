{
    "name": "crab/engine",
    "description": "A lightweight PHP 8.4 asynchronous networking engine",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "revolt/event-loop": "^1.0"
    },
    "suggest": {
        "ext-pcntl": "Supervised parallel workers and Unix signals",
        "ext-posix": "Supervised worker termination and lifecycle control"
    },
    "bin": ["bin/crab"],
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "test:linux": "tests/linux/run.sh",
        "soak": "python3 benchmarks/soak.py"
    },
    "autoload": {
        "psr-4": {
            "Crab\\Engine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Crab\\Engine\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "bangnokia",
            "email": "bangnokia@gmail.com"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    }
}
